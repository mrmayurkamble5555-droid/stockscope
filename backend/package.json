{
  "name": "stockscope-backend",
  "version": "1.0.0",
  "description": "StockScope API — NSE/BSE stock research platform",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev":        "ts-node -r dotenv/config src/server.ts",
    "build":      "tsc",
    "start":      "node -r dotenv/config dist/server.js",
    "migrate":    "ts-node -r dotenv/config src/db/migrate.ts",
    "seed":       "ts-node -r dotenv/config src/db/seedStocks.ts",
    "worker:run": "ts-node -r dotenv/config src/workers/runAll.ts",
    "test":       "jest --forceExit --detectOpenHandles",
    "test:cov":   "jest --coverage --forceExit",
    "audit:check":"npm audit --audit-level=high",
    "lint":       "tsc --noEmit"
  },
  "dependencies": {
    "axios":              "^1.6.7",
    "cors":               "^2.8.6",
    "dotenv":             "^16.4.5",
    "express":            "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "helmet":             "^8.1.0",
    "ioredis":            "^5.3.2",
    "node-cron":          "^3.0.3",
    "pg":                 "^8.11.3",
    "zod":                "^3.22.4"
  },
  "devDependencies": {
    "@types/cors":         "^2.8.19",
    "@types/express":      "^4.17.21",
    "@types/jest":         "^29.5.12",
    "@types/node":         "^20.11.24",
    "@types/node-cron":    "^3.0.11",
    "@types/pg":           "^8.11.2",
    "@types/supertest":    "^6.0.2",
    "jest":                "^29.7.0",
    "supertest":           "^7.0.0",
    "ts-jest":             "^29.1.2",
    "ts-node":             "^10.9.2",
    "typescript":          "^5.4.2"
  },
  "jest": {
    "preset":              "ts-jest",
    "testEnvironment":     "node",
    "testMatch":           ["**/__tests__/**/*.ts", "**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.d.ts"]
  }
}
